{
  "name": "@mnemorph/sdk",
  "version": "0.1.0",
  "description": "The client for mnemorphd: transports (stdio, WebSocket), reconnect by sequence, typed calls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaginari/mnemorph.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Kaginari/mnemorph#readme",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "dependencies": {
    "@mnemorph/protocol": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    }
  }
}
