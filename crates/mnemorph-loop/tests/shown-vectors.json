{
  "about": "Shared test vectors for `hidden` and `shown` (mnemorph_loop::run): the Rust tests and the board's TypeScript port both read this file. `escaped` is the rule itself: the ranges hidden beyond Unicode's controls (Cc), each inclusive, in hex; both suites check every code point against them, so the rule has one source. `prose` names what the transcript's prose keeps as written though it is hidden. A `hidden` entry names a code point in hex and whether it is hidden; a `shown` entry gives an input and the text a human is shown.",
  "escaped": [
    {
      "from": "ad",
      "to": "ad",
      "why": "SOFT HYPHEN (Cf): drawn only at a line break"
    },
    {
      "from": "34f",
      "to": "34f",
      "why": "COMBINING GRAPHEME JOINER (default-ignorable): draws nothing"
    },
    {
      "from": "600",
      "to": "605",
      "why": "Arabic number signs (Cf): span the text after them"
    },
    {
      "from": "61c",
      "to": "61c",
      "why": "ARABIC LETTER MARK (Cf): a bidi control"
    },
    {
      "from": "6dd",
      "to": "6dd",
      "why": "ARABIC END OF AYAH (Cf)"
    },
    {
      "from": "70f",
      "to": "70f",
      "why": "SYRIAC ABBREVIATION MARK (Cf)"
    },
    {
      "from": "890",
      "to": "891",
      "why": "Arabic pound and piastre marks above (Cf)"
    },
    {
      "from": "8e2",
      "to": "8e2",
      "why": "ARABIC DISPUTED END OF AYAH (Cf)"
    },
    {
      "from": "115f",
      "to": "1160",
      "why": "Hangul choseong and jungseong fillers (default-ignorable): blank letters"
    },
    {
      "from": "17b4",
      "to": "17b5",
      "why": "Khmer inherent vowels (default-ignorable): draw nothing"
    },
    {
      "from": "180b",
      "to": "180f",
      "why": "Mongolian free variation selectors and VOWEL SEPARATOR (U+180E, Cf): invisible"
    },
    {
      "from": "200b",
      "to": "200f",
      "why": "zero-width space, non-joiner, joiner (emoji sequences show it: approvals are exact), LRM, RLM"
    },
    {
      "from": "2028",
      "to": "202e",
      "why": "LINE and PARAGRAPH SEPARATOR (Zl, Zp), the bidi embeddings and overrides"
    },
    {
      "from": "2060",
      "to": "206f",
      "why": "word joiner, invisible operators, bidi isolates, deprecated format characters"
    },
    {
      "from": "3164",
      "to": "3164",
      "why": "HANGUL FILLER (default-ignorable): a blank letter"
    },
    {
      "from": "fe00",
      "to": "fe0f",
      "why": "variation selectors 1-16, U+FE0F too: after a letter it draws nothing; prose keeps it"
    },
    {
      "from": "feff",
      "to": "feff",
      "why": "ZERO WIDTH NO-BREAK SPACE (byte-order mark)"
    },
    {
      "from": "ffa0",
      "to": "ffa0",
      "why": "HALFWIDTH HANGUL FILLER (default-ignorable): a blank letter"
    },
    {
      "from": "fff0",
      "to": "fffb",
      "why": "reserved default-ignorables and the interlinear annotation controls (Cf)"
    },
    {
      "from": "110bd",
      "to": "110bd",
      "why": "KAITHI NUMBER SIGN (Cf)"
    },
    {
      "from": "110cd",
      "to": "110cd",
      "why": "KAITHI NUMBER SIGN ABOVE (Cf)"
    },
    {
      "from": "13430",
      "to": "1343f",
      "why": "Egyptian hieroglyph format controls (Cf)"
    },
    {
      "from": "1bca0",
      "to": "1bca3",
      "why": "shorthand format controls (Cf)"
    },
    {
      "from": "1d173",
      "to": "1d17a",
      "why": "musical symbol format controls (Cf)"
    },
    {
      "from": "e0000",
      "to": "e0fff",
      "why": "tag characters (invisible ASCII: a text smuggled in a text), variation selectors supplement, reserved default-ignorables"
    }
  ],
